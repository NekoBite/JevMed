# ── JevMed ERP — server configuration ─────────────────────────────────────────
# Copy to .env on the VPS. NEVER commit the real .env.

# Port the Node process listens on (nginx proxies to this)
PORT=8787

# Public origin, used for cookie security + CORS hardening
PUBLIC_ORIGIN=https://jevmed.trilumi.xyz

# ── Key vault ────────────────────────────────────────────────────────────────
# The hard-to-guess admin path. The vault lives at:
#   https://jevmed.trilumi.xyz/<VAULT_PATH>
# Generate a fresh one with:  openssl rand -hex 24
VAULT_PATH=ops-0000000000000000000000000000000000000000000000

# Passphrase that unlocks the vault. Store the SCRYPT HASH, not the passphrase.
# Generate with:  npm run start -- --hash-passphrase 'your passphrase here'
#   or:           node server/hash-passphrase.js 'your passphrase here'
VAULT_PASSPHRASE_HASH=

# 32-byte hex key used to encrypt the stored provider API keys at rest.
# Generate with:  openssl rand -hex 32
# If you lose this, stored API keys become unreadable (just re-enter them).
VAULT_MASTER_KEY=

# Where the encrypted vault file lives
DATA_DIR=./data
